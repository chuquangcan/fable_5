DATABASE_URL=postgresql://onethread:onethread@localhost:5433/onethread
DEMO_MODE=auto
AGENT_EFFORT=low
AGENT_TIMEOUT_S=30
# LLM provider for live mode: the key that is set decides (Claude wins if both are set).
# AGENT_PROVIDER=auto|anthropic|deepseek forces one (its key must be set). DeepSeek always uses the flash model.
AGENT_PROVIDER=auto
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
